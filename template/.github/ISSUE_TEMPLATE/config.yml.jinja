# Generated once by {{ github_username }}/repo-platform and never
# overwritten by template sync; tailor this chooser freely to the repository.
blank_issues_enabled: false
contact_links:
  - name: Report a security vulnerability (private)
    url: https://github.com/{{ github_username | lower }}/{{ project_slug }}/security/advisories/new
    about: Please report vulnerabilities privately via a GitHub security advisory, not a public issue.
