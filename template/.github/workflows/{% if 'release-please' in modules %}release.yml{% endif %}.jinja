# Repo-owned release pipeline, called by the managed ci.yml on top of the
# all-green gate. Generated once by {{ github_username }}/repo-platform and
# never overwritten by template sync.
#
# GitHub releases are immutable once published: the tag and assets freeze,
# and a post-publication `gh release upload` gets HTTP 422. Every release
# therefore moves through the same three steps, always draft-first:
#   1. release-please cuts the release as a DRAFT with its tag already
#      forced (`draft` + `force-tag-creation` in release-please-config.json).
#   2. update-release mutates the draft: this repository's packaging,
#      asset uploads, and note edits go there.
#   3. publish-release flips the draft live. It stays the last job: list
#      every job that mutates the release in its `needs`.
# If the pipeline dies after the draft exists, a rerun cannot recreate it
# (release-please sees the forced tag); finish by hand:
#   gh release upload <tag> <assets> --clobber
#   gh release edit <tag> --draft=false
# Everything runs in the same workflow run, so it works with the default
# GITHUB_TOKEN too, which cannot trigger `on: release` workflows.

name: Release

on:
  workflow_call:

jobs:
  release-please:
    uses: ./.github/workflows/release-please.yml
    secrets: inherit

  # Step 2: mutate the draft here. Replace the placeholder command with this
  # repository's release preparation; add sibling jobs freely, as long as
  # every job that touches the release lands in publish-release's needs.
  update-release:
    needs: [release-please]
    if: needs.release-please.outputs.release_created == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write # also what makes the draft visible to gh
    steps:
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
      - name: Update the draft release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          RELEASE_TAG: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
        # Repository-specific release preparation goes here, e.g.:
        #   ./build.sh
        #   gh release upload "$RELEASE_TAG" ./artifact --clobber
        run: echo "nothing to add to $RELEASE_TAG yet"

  # Step 3: freeze the release. This job stays last.
  publish-release:
    needs: [release-please, update-release]
    if: needs.release-please.outputs.release_created == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: write
    steps:
      - name: Publish the GitHub release
        env:
          GH_TOKEN: {% raw %}${{ secrets.REPO_PLATFORM_TOKEN || github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          TAG: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
        run: gh release edit "$TAG" --draft=false
