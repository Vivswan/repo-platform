# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# workflow_run fires same-repo only (hence this thin trigger; the
# judgment is repo-platform's reusable), and it executes the DEFAULT
# branch's copy of this file - changes land only after they merge.

name: All Green

on:
  workflow_run:
    workflows: [CI]
    types: [completed]
  # Copilot's review submission is the wake that re-judges a verdict left
  # pending on the owed review (a check run's completion fires no event).
  pull_request_review:
    types: [submitted]
  workflow_dispatch:
    inputs:
      sha:
        description: Commit whose newest completed CI run should be re-judged (the unwedge path for a lost workflow_run event).
        required: true
        type: string

permissions: {}

# Serialize judgments per sha so their check-run POSTs stay ordered. Never
# cancel: a verdict cancelled between judging and posting is a lost check.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.workflow_run.head_sha || github.event.pull_request.head.sha || inputs.sha }}{% endraw %}
  cancel-in-progress: false

jobs:
  verdict:
    permissions:
      checks: write
      actions: read
    uses: {{ github_username }}/repo-platform/.github/workflows/reusable-all-green.yml@build
    with:
      sha: {% raw %}${{ github.event_name == 'workflow_dispatch' && inputs.sha || '' }}{% endraw %}
      # Must have SUCCEEDED or the verdict fails closed: without this
      # anchor, editing the ci: job out of the managed ci.yml would disarm
      # every fleet gate.
      require-job: ci / validate-template
      # Renders true only on public repos - Copilot reviews are off on
      # private ones, so true there would pend forever.
      require-copilot-review: {{ (not private) | tojson }}
{%- set conditional_workflows = [] %}
      conditional-workflows: '{{ conditional_workflows | tojson }}'
