# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# The gate jobs live in fleet-ci.yml@build: an edit there changes this
# repository's CI with no PR here. Branch protection requires the
# `all-green` job's own check run: it needs every gating job and fails
# unless each result is success or skipped, with at least one success.

name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
{%- if enable_codeql %}
  # Weekly CodeQL re-scan with refreshed query packs.
  schedule:
    - cron: "3 8 * * 1"
{%- endif %}

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

jobs:
  # Repo-owned: edit checks.yml, not this file (no secrets; permissions
  # cap at contents: read).
  checks:
    uses: ./.github/workflows/checks.yml

  # This caller's permissions are the ceiling for every called job and
  # must stay UNCONDITIONAL: GitHub validates skipped jobs' grants too.
  ci:
    uses: {{ github_username }}/repo-platform/.github/workflows/fleet-ci.yml@build
    permissions:
      contents: read
      # validate-template posts its sticky findings comment.
      pull-requests: write
      # The ceiling for the CodeQL analysis calls.
      security-events: write
      actions: read
      # The ceiling for release-health's issue and Dependabot-alert reads.
      issues: read
      vulnerability-alerts: read
    with:
      modules: '{{ modules | tojson }}'
      private: {{ private | tojson }}
{%- if 'skills' in modules %}
      skills-dir: {{ skills_dir | tojson }}
{%- endif %}
{%- set codeql_languages = [] %}
{%- if enable_codeql %}
{%- if 'bun' in modules or 'node' in modules or 'deno' in modules %}{% set _ = codeql_languages.append('javascript-typescript') %}{% endif %}
{%- if 'uv' in modules %}{% set _ = codeql_languages.append('python') %}{% endif %}
{%- endif %}
      codeql-languages: '{{ codeql_languages | tojson }}'
{#- BEGIN GENERATED: tracking-labels (scripts/generate.ts - edit module.yml manifests, not this block) #}
{%- if 'fuzzer' in modules or 'nightly' in modules %}
      tracking-labels: {{ (([fuzzer_label] if 'fuzzer' in modules else []) + ([nightly_label] if 'nightly' in modules else [])) | join(',') | tojson }}
{%- endif %}
{#- END GENERATED: tracking-labels #}

  # THE gate: this job's own check run (named all-green, created by the
  # GitHub Actions app) is the ruleset's required check. It needs both
  # caller jobs and fails unless each result is success or skipped, with
  # at least one success - so a failed job anywhere in either called
  # workflow blocks the merge.
  all-green:
    needs: [checks, ci]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: {{ github_username }}/repo-platform/actions/all-green@build
        with:
          needs: {% raw %}${{ toJSON(needs) }}{% endraw %}
{% if 'release-please' in modules %}
  # Runs in the SAME workflow run as the judged commit, downstream of the
  # gate, so github.sha IS the judged commit; release.yml's head gate
  # still skips when main has moved on (the newer run releases).
  release:
    needs: [all-green]
    # result is spelled out so the release never depends on GitHub's
    # implied-success() rule; the event clauses keep PR, dispatch, and
    # schedule runs from ever releasing.
    if: >-
      needs.all-green.result == 'success' &&
      github.event_name == 'push' &&
      github.ref == 'refs/heads/main'
    # Deliberately a lane no group inside the called release.yml takes:
    # this job HOLDS it while its called jobs run, so one name would
    # deadlock.
    concurrency:
      group: post-green-release
      cancel-in-progress: false
    permissions:
      contents: write
      pull-requests: write
      packages: write
      id-token: write
      attestations: write
      issues: read
      vulnerability-alerts: read
    uses: ./.github/workflows/release.yml
    with:
      sha: {% raw %}${{ github.sha }}{% endraw %}
    secrets: inherit
{% endif %}