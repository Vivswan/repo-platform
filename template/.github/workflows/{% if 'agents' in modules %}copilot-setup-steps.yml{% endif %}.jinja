# Repo-owned setup for the GitHub Copilot coding agent: Copilot runs the
# job below (it MUST be named copilot-setup-steps) to prepare its
# development environment before working on this repository. Triggered on
# edits to itself so changes are validated in CI. Generated once by
# {{ github_username }}/repo-platform and never overwritten by template
# sync: add whatever setup the agent needs (dependencies, generated files,
# environment checks).

name: Copilot Setup Steps

on:
  workflow_dispatch:
  push:
    paths: [.github/workflows/copilot-setup-steps.yml]
  pull_request:
    paths: [.github/workflows/copilot-setup-steps.yml]

permissions:
  contents: read

jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    timeout-minutes: 59
    steps:
      - uses: actions/checkout@v7
{% if 'bun' in modules %}
      - uses: oven-sh/setup-bun@v2
      - uses: actions/cache@v4
        with:
          path: ~/.bun/install/cache
          key: {% raw %}bun-${{ runner.os }}-${{ hashFiles('**/bun.lock') }}{% endraw %}
          restore-keys: {% raw %}bun-${{ runner.os }}-{% endraw %}
      - name: Install dependencies (bun)
        run: bun install --frozen-lockfile
{% endif %}{% if 'uv' in modules %}
      - uses: astral-sh/setup-uv@v9.0.0
      - name: Install dependencies (uv)
        run: uv sync
{% endif %}