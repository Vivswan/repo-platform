# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# Build contract (PAGES_BASE_PATH, PAGES_ORIGIN, PAGES_STAGING) and the
# CUSTOM_DOMAIN cutover: repo-platform's docs/pages.md. One-time setup:
# repo Settings -> Pages -> Source: GitHub Actions.
name: Pages

on:
  push:
    branches: [main]
  release:
    types: [published]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    uses: {{ github_username }}/repo-platform/.github/workflows/reusable-pages.yml@main
    with:
      setup: {{ pages_setup }}
      install_command: {{ pages_install_command | tojson }}
      build_command: {{ pages_build_command | tojson }}
      dist_dir: {{ pages_dist_dir | tojson }}
      production: {{ pages_production }}
      staging: {{ 'true' if pages_staging and pages_production == 'release' else 'false' }}
      custom_domain: {% raw %}${{ vars.CUSTOM_DOMAIN }}{% endraw %}
    permissions:
      contents: read
      pages: write
      id-token: write
