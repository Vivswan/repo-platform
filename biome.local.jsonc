// The repository's own layer: exclusions, formatter, lint preferences, plugins. biome.json holds the floor and extends this file.
{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  // files/bun/biome.json is the floor the sync ships; force-ignored (`!!`), or biome reads it as a nested root configuration.
  "files": {
    // The sync writer's YAML sources, and the end-to-end fixtures standing in for them, carry `{{placeholder}}` tokens
    // and indentation-relative fragments, which are not YAML before the writer renders them (the root .yamllint skips
    // them for the same reason); the rendered copies are judged in the fleet lint tree.
    // A license is kept verbatim, wherever it sits (the floor's override says the same once the self-sync carries it).
    // The managed review instructions follow their source under files/base, which is judged here, and lag it by one
    // self-sync.
    "includes": [
      "**",
      "!.github/repo-platform-manifest.json",
      "!!files/bun/biome.json",
      "!files/**/*.yml",
      "!files/**/*.yaml",
      "!tests/ci/sync_end_to_end/fixtures/**/*.yml",
      "!**/LICENSE.md",
      "!.github/instructions/review.instructions.md"
    ]
  },
  // The docs' `---` frontmatter is data, not a heading.
  "markdown": { "parser": { "frontmatter": true } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "quoteProperties": "preserve",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "overrides": [
    {
      // The generated pair is the sync's output, never formatted (the managed biome.json says the same).
      "includes": [".github/repo-platform-manifest.json", ".github/settings.yml"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "actions/**",
        ".github/scripts/**",
        "scripts/**",
        "!**/*.test.ts",
        "!actions/shared/platform.ts",
        "!migrations/**"
      ],
      "plugins": ["./biome/platform_name.grit"]
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "use tests/shared/temp_dir.ts"
                  },
                  "node:fs/promises": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "use tests/shared/temp_dir.ts"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/shared/temp_dir.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/ci/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "use tests/shared/temp_dir.ts"
                  },
                  "node:fs/promises": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "use tests/shared/temp_dir.ts"
                  }
                },
                "patterns": [
                  {
                    "group": ["**/.github/**"],
                    "message": "a CI harness runs the script as a subprocess; an in-process import tests the module inside bun-test, not the script CI runs"
                  }
                ]
              }
            },
            "noCommonJs": "error"
          }
        }
      }
    },
    {
      "includes": ["tests/ci/bun_setup_smoke.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "use tests/shared/temp_dir.ts"
                  },
                  "node:fs/promises": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "use tests/shared/temp_dir.ts"
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "**/.github/**",
                      "!**/.github/scripts/ci/bun_setup_smoke",
                      "!**/.github/scripts/ci/bun_setup_smoke.ts"
                    ],
                    "message": "a CI harness runs the script as a subprocess; an in-process import tests the module inside bun-test, not the script CI runs"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**",
        ".github/scripts/**",
        "tests/**",
        "!.github/scripts/shared/proc.ts",
        "!tests/shared/bounded_spawn.ts",
        "!tests/fleet/select_settings_repos.test.ts",
        "!tests/fleet/select_sync_repos.test.ts"
      ],
      "plugins": ["./biome/spawn_sync.grit"]
    },
    {
      "includes": [
        "scripts/**",
        ".github/scripts/**",
        "tests/**",
        "actions/**",
        "!scripts/run_tests.ts",
        "!tests/actions/pages-site/headless_chrome.ts",
        "!tests/shared/loopback_server.ts",
        "!actions/release-health/release-health.ts"
      ],
      "plugins": ["./biome/spawn_async.grit"]
    },
    {
      "includes": [
        "scripts/**",
        ".github/scripts/**",
        "actions/**",
        "!actions/validate-commit-names/commitlint.ts"
      ],
      "plugins": ["./biome/stream_write.grit"]
    },
    // A migration rung is frozen once shipped and never edited, so its complexity is never paid again.
    {
      "includes": ["migrations/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    // A test table is data, not a function body.
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ]
}
