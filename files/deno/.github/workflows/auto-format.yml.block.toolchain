
      - uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2.0.5
        with:
          deno-version-file: .dvmrc
          cache: true
      - name: Format (deno)
        env:
          DENO_NO_UPDATE_CHECK: "1"
        run: |
          deno lint --fix || true
          # Markdown prose is never re-wrapped: documents carry no width limit.
          deno fmt --prose-wrap preserve
