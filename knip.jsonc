{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  // Every script runs by path (package.json scripts, workflows, bun test), so the entry globs are
  // wide and entry exports are judged too, or a dead export in a shared library would never surface.
  // An action whose scripts need no package of their own (actions/semgrep) is read as part of the root.
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts",
        ".github/scripts/**/*.ts",
        "actions/semgrep/*.ts",
        "migrations/**/*.ts",
        "tests/**/*.ts"
      ],
      "project": ["**/*.{ts,mts}"],
      // The lint scripts run `bun node_modules/.bin/biome` so its node-shebang launcher runs under bun; knip reads only
      // `bun x biome` or a bare `biome` as a use.
      "ignoreDependencies": ["@biomejs/biome"]
    },
    "actions/*": {
      // Action entrypoints run by path from action.yml, at the action root.
      "entry": ["*.ts", "!*[._]{test,spec}.ts"],
      "project": ["**/*.{ts,mts}"]
    },
    "actions/validate-commit-names": {
      "entry": ["*.ts", "!*[._]{test,spec}.ts"],
      "project": ["**/*.{ts,mts}"],
      // commitlint.config.mjs names the preset in `extends` and commitlint's load() resolves it; nothing imports it.
      "ignoreDependencies": ["@commitlint/config-conventional"]
    },
    "actions/validate-managed-files": {
      // The three step scripts and the hygiene validator action.yml runs, and the byte-to-byte check run by path.
      "entry": [
        "check.ts",
        "src/read_commit.ts",
        "src/run.ts",
        "src/report.ts",
        "validator/validate_managed_files.ts"
      ],
      "project": ["**/*.{ts,mts}"]
    },
    "actions/pages-site": {
      // The scripts action.yml runs; the vitepress plugin adds the config and theme.
      "entry": ["build.ts"],
      "project": ["**/*.{ts,mts,vue}"],
      "includeEntryExports": false,
      // shiki and markdown-it are imported directly but arrive through vitepress.
      "ignoreDependencies": ["shiki", "markdown-it"]
    }
  }
}
