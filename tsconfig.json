{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/**/*.ts",
    ".github/scripts/**/*.ts",
    "actions/shared/**/*.ts",
    "actions/*/*.d.ts",
    "actions/knip/**/*.ts",
    "actions/semgrep/**/*.ts",
    "migrations/**/*.ts",
    "tests/**/*.ts"
  ]
}
