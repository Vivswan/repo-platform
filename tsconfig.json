{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/**/*.ts",
    ".github/scripts/**/*.ts",
    "actions/shared/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/fleet/build_settings_matrix.test.ts",
    "tests/fleet/fleet_sync_marker.test.ts",
    "tests/fleet/redact.test.ts",
    "tests/fleet/repos_registry.test.ts",
    "tests/fleet/select_settings_repos.test.ts",
    "tests/fleet/select_sync_repos.test.ts"
  ]
}
