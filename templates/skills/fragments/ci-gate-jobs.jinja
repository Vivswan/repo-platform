
  # Structural validation of the hosted agent skills (the skills module),
  # inside the gate so branch protection blocks on a broken catalog:
  # offline and cheap, so it runs unconditionally on every event. The
  # network-dependent `npx skills` discovery check stays advisory in the
  # standalone validate-skills.yml.
  validate-skills:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7
      - uses: {{ github_username }}/repo-platform/actions/validate-skills@build
        with:
          skills-dir: {{ skills_dir | tojson }}
