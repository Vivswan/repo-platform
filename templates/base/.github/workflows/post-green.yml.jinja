# Repo-owned: generated once by {{ github_username }}/repo-platform, never
# overwritten by sync. Called after the all-green gate on every green push
# to main, before the release: REPLACE the no-op job with this repository's
# work (it uses a runner allocation per push until you do; the contract is in
# repo-platform's docs/all-green.md, "After the gate").

name: Post Green

on:
  workflow_call:
    inputs:
      sha:
        description: The green main commit the calling run judged.
        required: true
        type: string

jobs:
  noop:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - env:
          SHA: {% raw %}${{ inputs.sha }}{% endraw %}
        run: echo "post-green hook for $SHA - nothing configured"
