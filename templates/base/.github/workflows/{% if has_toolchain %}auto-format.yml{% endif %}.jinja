# Repo-owned: generated once by {{ github_username }}/repo-platform, never
# overwritten by template sync - adjust the format commands freely. The
# push uses github.token, which starts no workflows; a PAT would
# re-trigger CI, but any same-repo PR's formatter tooling runs in this
# checkout before the push - only wire in a token you would expose to it.

name: Auto Format

on:
  pull_request:
    types: [labeled]

# Per-label group: unrelated labels skip in their own group, while
# re-adding fix-lint cancels the older fix-lint run in favor of the newest.
concurrency:
  group: auto-format-{% raw %}${{ github.event.pull_request.number }}-${{ github.event.label.name }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  format:
    # GITHUB_TOKEN cannot push to a fork's branch, and PR-controlled tool
    # configuration must not run next to write credentials.
    if: github.event.label.name == 'fix-lint' && github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {% raw %}${{ github.event.pull_request.head.ref }}{% endraw %}
          persist-credentials: false
{# compose:auto-format #}
      - name: Commit and push changes
        id: push
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          HEAD_REF: {% raw %}${{ github.event.pull_request.head.ref }}{% endraw %}
        run: |
          if git diff --quiet; then
            echo "nothing to format"
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "style: apply automated formatting"
          git push "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" HEAD:"$HEAD_REF"
          # The push succeeded, so the pending approval is a notice, not a failure.
          echo "no_retrigger=true" >> "$GITHUB_OUTPUT"
          echo "::warning::formatting commit pushed with github.token: the new head's pull_request run waits for approval. Open it in the Actions tab and choose Approve and run, or push an empty commit."
      # One comment per PR, edited in place on later runs; a failed post
      # fails the step.
      - name: Comment that checks will not re-run
        if: steps.push.outputs.no_retrigger == 'true'
        uses: marocchino/sticky-pull-request-comment@5770ad5eb8f42dd2c4f34da00c94c5381e49af88 # v3.0.5
        with:
          header: repo-platform/auto-format
          message: >
            Pushed a formatting commit with the default workflow token, which starts no workflows,
            so the new head's `pull_request` run waits for approval.
            Open it in the Actions tab and choose **Approve and run**, or push an empty commit.
      # The label is a one-shot request: remove it even when a step failed,
      # so a broken run cannot loop.
      - name: Remove the fix-lint label
        if: always()
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PR_URL: {% raw %}${{ github.event.pull_request.html_url }}{% endraw %}
        run: gh pr edit "$PR_URL" --remove-label fix-lint
