# Repo-owned: generated once by {{ github_username }}/repo-platform, never
# overwritten by template sync. Packaging, asset uploads, and note edits
# go here; publishing waits for every job, and every asset uploaded here
# is attested at publish time.

name: Update Release

on:
  workflow_call:
    inputs:
      tag:
        description: The draft release's tag (forced at creation, so it is checkout-able before publication)
        required: true
        type: string

jobs:
  update-release:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write # also what makes the draft visible to gh
    steps:
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ inputs.tag }}{% endraw %}
      - name: Update the draft release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          RELEASE_TAG: {% raw %}${{ inputs.tag }}{% endraw %}
        # Repository-specific release preparation goes here, e.g.:
        #   ./build.sh
        #   gh release upload "$RELEASE_TAG" ./artifact --clobber
        run: echo "nothing to add to $RELEASE_TAG yet"
