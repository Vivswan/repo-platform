# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# Re-arms ci.yml's fail-fast copilot-review gate. That job fails immediately
# when Copilot's review is expected but has not posted yet - zero runner time
# instead of a billed polling wait - and this workflow re-runs JUST that job
# once the review is in. Two triggers cover both orderings of "the review
# posts" against "CI finishes":
#
#   - pull_request_review submitted by Copilot: the review is here. If the
#     head sha's latest CI run already completed with a failed copilot-review
#     job, re-run that job. A run still in progress is left alone (jobs of a
#     live run cannot be re-run) - its own completion fires the second
#     trigger.
#   - workflow_run CI completed (failure): if the copilot-review job failed
#     AND the review has arrived meanwhile, re-run it. Without the arrival the
#     re-run would only fail again, so the review trigger handles it later.
#
# Guards, all quiet no-ops: no CI run for the sha, a run without the job, a
# job that did not fail, and a run past the attempt cap - a loop-breaker,
# because a re-run's own completion fires the workflow_run trigger again.
#
# Unlike ci.yml's gate jobs, nothing here is inside all-green, so the
# relevance test is a JOB-level `if:` rather than a step-level one: an
# irrelevant event starts no job at all, and on a private repository a
# started-then-skipped job still bills a rounded-up minute.
#
# EXPECT action_required: GitHub holds a run for manual approval when the
# triggering actor is the Copilot bot, so this workflow can land with that
# conclusion and no jobs run at all. It is GitHub actor policy and no REST
# API exposes a toggle. When it happens, open the failed CI run and pick
# Re-run jobs, then Re-run failed jobs. That re-runs copilot-review
# together with the all-green job that needs it, and both go green once
# the review has arrived.
#
# FORK PRs: a pull_request_review run on a fork's PR gets a read-only
# token, so `gh run rerun` cannot re-run anything and this workflow fails
# instead of re-arming. It only bites when Copilot reviews AFTER CI has
# finished; a review that lands mid-run is covered by the workflow_run
# trigger, which runs in the base repository's own context. Fork-PR
# operators use the same manual re-run as above. See
# https://github.com/{{ github_username }}/repo-platform/blob/main/docs/all-green.md.

name: Rerun Copilot Gate

on:
  pull_request_review:
    types: [submitted]
  workflow_run:
    workflows: [CI]
    types: [completed]

# Actions write re-runs the failed gate job; checks and pull-requests read
# answer "did the review arrive" on the CI-completed path.
permissions:
  actions: write
  checks: read
  pull-requests: read
  contents: read

jobs:
  rerun:
    # Only two event shapes matter: a Copilot-authored review, or a FAILED
    # pull_request CI run (a push run's gate passes trivially, and a green run
    # needs no re-arm).
    if: >-
      {% raw %}${{
        (github.event_name == 'pull_request_review' &&
         contains(fromJSON('["copilot-pull-request-reviewer[bot]", "Copilot"]'), github.event.review.user.login)) ||
        (github.event_name == 'workflow_run' &&
         github.event.workflow_run.event == 'pull_request' &&
         github.event.workflow_run.conclusion == 'failure')
      }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      # No checkout and no toolchain: `gh api` reads only, so the job costs
      # seconds whichever trigger fired it.
      - name: Re-run the copilot-review job if the review arrived
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          HEAD_SHA: >-
            {% raw %}${{ github.event_name == 'workflow_run' &&
                github.event.workflow_run.head_sha ||
                github.event.pull_request.head.sha }}{% endraw %}
          # The completed CI run, on the workflow_run trigger only; empty on
          # the review trigger, which has to look the run up.
          RUN_ID: {% raw %}${{ github.event_name == 'workflow_run' && github.event.workflow_run.id || '' }}{% endraw %}
          GATE_JOB: copilot-review
          COPILOT_CHECK: copilot-pull-request-reviewer
          # A re-run's completion fires the workflow_run trigger again, so a
          # persistently failing gate must stop re-arming itself.
          MAX_ATTEMPTS: "5"
        run: |
          set -euo pipefail
          # Nothing re-runs this re-runner, so unlike the gate itself a failed
          # read is fatal here: going quiet would strand a red gate. jq takes
          # HEAD_SHA, GATE_JOB and COPILOT_CHECK from the environment, so the
          # only thing spliced into a jq program is the static $defs prelude.
          api() { timeout 20 gh api "$1"; }
          die() { echo "::error::rerun-copilot-gate: $1"; exit 1; }
          # Every quiet no-op below is a decision to leave a red gate alone,
          # so each one has to be taken on a body we actually read. gh exits 0
          # on some error payloads, and jq reads a missing field as null, so
          # without these assertions `{}` would answer "no CI run" or "status
          # null" and this workflow would exit 0 having stranded the gate.
          # errexit turns any of them into a loud failure, which is the right
          # outcome when nothing re-runs you.
          defs='def arr: if type == "array" then . else error("expected an array") end; def obj: if type == "object" then . else error("expected an object") end; def str: if type == "string" then . else error("expected a string") end; def num: if type == "number" then . else error("expected a number") end; def is_copilot: ascii_downcase | . == "copilot" or . == (env.COPILOT_CHECK + "[bot]");'

          # The review trigger looks the run up; workflow_run carries it.
          if [ -z "$RUN_ID" ]; then
            runs="$(api "repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs?head_sha=$HEAD_SHA&event=pull_request&per_page=1")" ||
              die "listing CI runs at $HEAD_SHA failed."
            run="$(jq -c "$defs"'obj | .workflow_runs | arr | .[0] // empty' <<< "$runs")"
            if [ -z "$run" ]; then
              echo "::notice::no pull_request CI run exists at $HEAD_SHA; nothing to re-arm."
              exit 0
            fi
          else
            run="$(api "repos/$GITHUB_REPOSITORY/actions/runs/$RUN_ID")" ||
              die "reading CI run $RUN_ID failed."
            [ -n "$run" ] || die "CI run $RUN_ID came back empty."
          fi
          run_id="$(jq -r "$defs"'obj | .id | num' <<< "$run")"
          status="$(jq -r "$defs"'obj | .status | str' <<< "$run")"
          attempt="$(jq -r "$defs"'obj | .run_attempt | num' <<< "$run")"

          if [ "$status" != completed ]; then
            echo "::notice::CI run $run_id at $HEAD_SHA is still '$status'; its completion re-fires this workflow, so nothing to do yet."
            exit 0
          fi
          if [ "$attempt" -ge "$MAX_ATTEMPTS" ]; then
            echo "::warning::CI run $run_id is already on attempt $attempt; refusing to re-arm the $GATE_JOB job again (loop-breaker). Re-run it manually if Copilot's review really arrived."
            exit 0
          fi

          jobs="$(api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id/jobs?filter=latest&per_page=100")" ||
            die "listing the jobs of CI run $run_id failed."
          gate="$(jq -c "$defs"'obj | .jobs | arr | first(.[] | select(.name == env.GATE_JOB)) // empty' <<< "$jobs")"
          if [ -z "$gate" ]; then
            echo "::notice::CI run $run_id has no $GATE_JOB job; nothing to re-arm."
            exit 0
          fi
          job_id="$(jq -r "$defs"'obj | .id | num' <<< "$gate")"
          conclusion="$(jq -r "$defs"'obj | .conclusion // "null"' <<< "$gate")"
          if [ "$conclusion" != failure ]; then
            echo "::notice::the $GATE_JOB job of CI run $run_id concluded '$conclusion'; no re-run needed."
            exit 0
          fi

          # On the CI-completed trigger the review may not have arrived at all
          # (CI can fail red for any reason). Both arrival forms the gate
          # accepts count: the completed check run, or a Copilot review posted
          # for the head sha, reached through the commit's associated PRs. The
          # review trigger IS the arrival, so it skips this.
          if [ -n "$RUN_ID" ]; then
            checks="$(api "repos/$GITHUB_REPOSITORY/commits/$HEAD_SHA/check-runs?check_name=$COPILOT_CHECK&filter=latest")" ||
              die "reading the $COPILOT_CHECK check runs at $HEAD_SHA failed."
            arrived="$(jq -r "$defs"'obj | .check_runs | arr | map(select(.status == "completed")) | length > 0' <<< "$checks")"
            if [ "$arrived" != true ]; then
              pulls="$(api "repos/$GITHUB_REPOSITORY/commits/$HEAD_SHA/pulls")" ||
                die "listing the pull requests at $HEAD_SHA failed."
              number="$(jq -r "$defs"'arr | first(.[] | select(.head.sha == env.HEAD_SHA) | .number) // empty' <<< "$pulls")"
              if [ -n "$number" ]; then
                reviews="$(api "repos/$GITHUB_REPOSITORY/pulls/$number/reviews?per_page=100")" ||
                  die "reading the reviews of PR #$number failed."
                arrived="$(jq -r "$defs"'arr | map(select(.user != null and .commit_id == env.HEAD_SHA) | select(.user.login | is_copilot)) | length > 0' <<< "$reviews")"
              fi
            fi
            if [ "$arrived" != true ]; then
              echo "::notice::the $GATE_JOB job failed but Copilot's review has not arrived at $HEAD_SHA; the review's own submission re-fires this workflow."
              exit 0
            fi
          fi

          timeout 20 gh run rerun --job "$job_id" -R "$GITHUB_REPOSITORY" ||
            die "re-running the $GATE_JOB job $job_id failed."
          echo "re-armed: $GATE_JOB job $job_id of CI run $run_id is re-running."
