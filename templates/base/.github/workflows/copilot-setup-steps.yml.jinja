# Copilot runs this job (it MUST be named copilot-setup-steps) to prepare
# its environment; the push/PR triggers exist so edits to this file are
# validated in CI. Generated once by {{ github_username }}/repo-platform,
# never overwritten by template sync.

name: Copilot Setup Steps

on:
  workflow_dispatch:
  push:
    paths: [.github/workflows/copilot-setup-steps.yml]
  pull_request:
    paths: [.github/workflows/copilot-setup-steps.yml]

permissions:
  contents: read

jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    timeout-minutes: 59
    steps:
      - uses: actions/checkout@v7
