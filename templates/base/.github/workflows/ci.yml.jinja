{#- The five base checks below are written once: public repos wrap each in
    its own job (the if-not-private headers); private repos collect the
    same steps into one base-checks job, each step guarded so every check
    still runs when an earlier one fails. -#}
# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# The all-green convention: branch protection requires only the `all-green`
# check, which needs every other job here, so the required-checks list never
# changes as jobs come and go. This repository's own test and lint jobs live
# in checks.yml (repo-owned, never overwritten by sync) and run inside the
# gate through the `checks` job. Module checks (the pr-title title check,
# CodeQL analysis) run inside the gate too, so branch protection blocks on
# them without extra required checks.
#
# The base checks (typography, commit-names, actionlint, yamllint, gitleaks)
# render as one job each on public repositories and as steps of a single
# base-checks job on private ones, where every job bills a rounded-up minute.

name: CI

on:
  push:
    branches: [main]
  # `edited` on top of the default three: a PR title edit must re-run the
  # gate so title-sensitive checks (the pr-title module) stay honest. The
  # cancel-in-progress concurrency below bounds the extra runs.
  pull_request:
    types: [opened, edited, reopened, synchronize]
  workflow_dispatch:
{%- if enable_codeql %}
  # Weekly CodeQL re-scan with refreshed query packs; every other gate job
  # is event-agnostic or skips its work cleanly on non-PR events.
  schedule:
    - cron: "3 8 * * 1"
{%- endif %}

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

jobs:
  # Repo-owned checks: edit .github/workflows/checks.yml, not this file. No
  # secrets are passed and permissions cap at contents: read; a check that
  # needs either belongs in its own workflow (see
  # https://github.com/{{ github_username }}/repo-platform/blob/main/docs/all-green.md).
  checks:
    uses: ./.github/workflows/checks.yml

  # Informational, deliberately NOT in all-green's needs: a red run flags
  # template-convention drift (usually local edits to managed files), but
  # it never blocks this repository's merges - the next sync PR heals it.
  validate-template:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      - uses: {{ github_username }}/repo-platform/actions/validate-template@main
{%- if private %}

  base-checks:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
      pull-requests: read
    steps:
      # One checkout serves every check: fetch-depth 0 because commit-names
      # walks history and gitleaks scans the event's commit range.
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
{%- endif %}
{%- if not private %}

  typography:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7
{%- endif %}
      - uses: {{ github_username }}/repo-platform/actions/check-typography@main
{%- if private %}
        if: '!cancelled()'
{%- endif %}
{%- if not private %}

  commit-names:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
{%- endif %}
      - uses: {{ github_username }}/repo-platform/actions/validate-commit-names@main
{%- if private %}
        if: '!cancelled()'
{%- endif %}
{%- if not private %}

  actionlint:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7
{%- endif %}
      - uses: raven-actions/actionlint@v2
{%- if private %}
        if: '!cancelled()'
{%- endif %}
{%- if not private %}

  yamllint:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7
{%- endif %}
      - name: Install yamllint
{%- if private %}
        if: '!cancelled()'
{%- endif %}
        run: python3 -m pip install --quiet yamllint
      - name: Lint YAML
{%- if private %}
        if: '!cancelled()'
{%- endif %}
        run: yamllint -s .
{%- if not private %}

  gitleaks:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      pull-requests: read
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
{%- endif %}
      # Secret scanning: a committed credential fails the gate. The action
      # scans the event's commit range (fetch-depth 0 above lets any range
      # resolve); audit the OLD history once with a local `gitleaks git`.
      # Personal-account repos need no GITLEAKS_LICENSE; allowlist false
      # positives in the repo-owned .gitleaks.toml at the repository root
      # (seeded by the template, never overwritten by sync).
      # pull-requests read on this job: the action lists the PR's commits
      # to build the scan range. Comments off keeps that scope at read;
      # leaks still land in the job summary and SARIF artifact.
      - uses: gitleaks/gitleaks-action@v3
{%- if private %}
        if: '!cancelled()'
{%- endif %}
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          GITLEAKS_ENABLE_COMMENTS: "false"
          # The action's default binary (8.24.3) predates .gitleaks.toml's
          # minVersion floor AND skips that check silently; pin one meeting
          # the floor so CI honors the same config local runs do.
          GITLEAKS_VERSION: "8.30.1"
{%- if not private %}

  # Fails when a PR introduces dependencies with known vulnerabilities, by
  # diffing the dependency graph between base and head. Public renders only:
  # the dependency-graph API behind it is free just for public repositories.
  # Only PR events have a diff to review, so the skip lives on the steps:
  # all-green treats a skipped needed job as failure, so the job itself
  # stays unconditional.
  dependency-review:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7
        if: github.event_name == 'pull_request'
      # The severity threshold and the upstream pin live in the wrapper.
      - uses: {{ github_username }}/repo-platform/actions/dependency-review@main
        if: github.event_name == 'pull_request'
{%- endif %}
{%- if enable_codeql %}

  # CodeQL analysis runs inside the gate (one job per language), so a failed
  # scan blocks merges. Each job grants the scan permissions - a caller
  # job's permissions are the ceiling for the called workflow - and the
  # weekly re-scan schedule lives on this workflow's triggers.
  # Repo-specific scan tuning (paths-ignore, extra queries, packs) goes in
  # the repo-owned .github/codeql/codeql-config.yml - the standard CodeQL
  # config file, picked up automatically when present.
{# compose:codeql-languages #}
{%- endif %}

  # Copilot's automatic PR review must have ARRIVED before the gate goes
  # green - but only when Copilot is actually involved in the PR. ONE SHOT,
  # fail-fast: when the review is expected (the base branch's
  # copilot_code_review rule - the fleet ruleset sets it, so this is the
  # normal path - or a live involvement signal) but has not posted yet, this
  # job fails in seconds instead of burning billed runner time waiting, and
  # rerun-copilot-gate.yml re-runs just this job the moment the review lands.
  # Any review conclusion counts: the ruleset's required review thread
  # resolution polices the content, this job only polices the timing. It sits
  # inside the gate because a ruleset-side required check cannot express it -
  # Copilot's check suite never appears in PR merge-box rollups, so requiring
  # that context there hangs the merge box forever.
  #
  # With no rule and no involvement signal this job passes non-blocking,
  # logging that Copilot is not a reviewer - but on a settings-sync repo the
  # rule comes from the fleet override layer, which is applied last and cannot
  # be dropped from this repository (a hand-deleted rule returns on the next
  # nightly apply). Not selecting settings-sync, or a repos.yml exclusion, is
  # what opts a repo out; changing the override itself is a fleet-wide
  # decision. Failures are closed, never silent - an API probe that did not
  # come back is treated as "cannot tell", not as "not involved".
  #
  # No checkout and no toolchain: three or four `gh api` reads and no sleeps,
  # so the job costs seconds of runner time. That is why it stays its own job
  # on private repositories instead of joining base-checks - the job name is
  # what rerun-copilot-gate.yml re-runs, and folding it in would make every
  # re-arm replay all five base checks. Non-PR events have no review to await,
  # so the step skips; the job itself stays unconditional for the strict gate.
  copilot-review:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      checks: read
      pull-requests: read
    steps:
      - name: Check that the Copilot review arrived
        if: github.event_name == 'pull_request'
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
          BASE_BRANCH: {% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
          # Copilot's identity, spelled once: the check run it creates on the
          # head sha, and (suffixed with [bot]) the login its review posts
          # under. It is REQUESTED as the plain "Copilot" login.
          COPILOT_CHECK: copilot-pull-request-reviewer
        run: |
          set -euo pipefail
          # Each probe records whether its call CAME BACK, because a read that
          # failed must never count as "Copilot is not involved". Every call
          # carries a hard deadline and the job never sleeps. jq takes
          # HEAD_SHA and COPILOT_CHECK from the environment, so the only
          # thing ever spliced into a jq program is the static $defs prelude
          # below - no response data reaches jq as source text.
          api() { timeout 20 gh api "$1"; }
          api_paginated() { timeout 20 gh api --paginate --slurp "$1"; }
          # Answers strictly: anything that is not a bare true/false - jq
          # erroring on a malformed body, or yielding nothing at all on an
          # empty one - is a MISSING answer, and the caller clears the same
          # flag a failed call would.
          ask() {
            local answer
            answer="$(jq -r "$2" <<< "$1")" || return 1
            case "$answer" in
              true|false) printf '%s' "$answer" ;;
              *) return 1 ;;
            esac
          }
          # The jq prelude, spliced into every probe below.
          #
          # `arr` is load-bearing, not decoration. jq iterates an OBJECT's
          # values happily, so a body like `{}` (a plain error payload gh
          # still exits 0 on) makes an unguarded `[.[] | select(...)] |
          # length > 0` answer a confident `false`, and the gate then passes
          # as "not a reviewer" on a response it never actually read. Every
          # probe therefore asserts its shape first and errors out otherwise,
          # which `ask` turns into a cleared flag and a fail-closed exit.
          #
          # `is_copilot` is Copilot's identity in ONE place: it posts reviews
          # under the "<check>[bot]" login and is requested as the plain
          # "Copilot" login, and either spelling can turn up in either place.
          defs='def arr: if type == "array" then . else error("expected an array") end; def pages: arr | map(arr) | add // []; def is_copilot: ascii_downcase | . == "copilot" or . == (env.COPILOT_CHECK + "[bot]"); def mine: [.[] | select(.user != null) | select(.user.login | is_copilot)];'

          rules_ok=1
          rules="$(api "repos/$GITHUB_REPOSITORY/rules/branches/$BASE_BRANCH")" || rules_ok=0
          checks_ok=1
          checks="$(api "repos/$GITHUB_REPOSITORY/commits/$HEAD_SHA/check-runs?check_name=$COPILOT_CHECK&filter=latest")" || checks_ok=0
          reviews_ok=1
          # --paginate: GitHub returns reviews oldest-first, so a single page
          # shows only the STALEST 100 on a busy PR and Copilot's latest review
          # would be invisible. --slurp yields one array per page; `pages`
          # flattens them. The deadline wraps the whole paginated read, exactly
          # as the operator twin budgets it.
          reviews="$(api_paginated "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/reviews?per_page=100")" || reviews_ok=0

          # An unreadable body is a missing answer too, so a jq failure clears
          # the same flag a failed call would.
          check_done=false check_seen=false
          if [ "$checks_ok" = 1 ]; then
            check_done="$(ask "$checks" "$defs"'.check_runs | arr | map(select(.status == "completed")) | length > 0')" || checks_ok=0
            check_seen="$(ask "$checks" "$defs"'.check_runs | arr | length > 0')" || checks_ok=0
          fi
          review_at_head=false review_seen=false
          if [ "$reviews_ok" = 1 ]; then
            review_at_head="$(ask "$reviews" "$defs"'pages | mine | map(select(.commit_id == env.HEAD_SHA)) | length > 0')" || reviews_ok=0
            review_seen="$(ask "$reviews" "$defs"'pages | mine | length > 0')" || reviews_ok=0
          fi
          rule_expects=false
          if [ "$rules_ok" = 1 ]; then
            rule_expects="$(ask "$rules" "$defs"'arr | map(select(.type == "copilot_code_review")) | length > 0')" || rules_ok=0
          fi

          # Names the human action on purpose: there is no API that triggers
          # a Copilot review, so "wait and hope" is not a complete
          # instruction when the auto-request never fired.
          awaiting="::error::waiting for Copilot review at $HEAD_SHA (no completed '$COPILOT_CHECK' check run and no posted review yet). Copilot is usually requested automatically when you push; if nothing appears after a few minutes, request it by hand from the PR sidebar under Reviewers -> Copilot (a draft PR or an exhausted review quota suppresses the automatic request). This job re-runs itself when the review posts; if it does not, open this CI run and pick Re-run jobs, then Re-run failed jobs."

          # 1. Arrived, whatever it concluded.
          if [ "$check_done" = true ] || [ "$review_at_head" = true ]; then
            echo "Copilot's review ($COPILOT_CHECK) arrived at $HEAD_SHA."
            exit 0
          fi
          # 2. Expected by configuration: the base branch carries the rule.
          if [ "$rule_expects" = true ]; then
            echo "$BASE_BRANCH's rules include copilot_code_review: the review is expected by configuration."
            echo "$awaiting"
            exit 1
          fi
          # 3. No rule: probe live involvement. GitHub CONSUMES the reviewer
          #    request once the review posts, so an OLDER sha's review counts
          #    as involvement - the re-review is awaited - not as arrival.
          pull_ok=1
          pull="$(api "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER")" || pull_ok=0
          requested=false
          if [ "$pull_ok" = 1 ]; then
            requested="$(ask "$pull" "$defs"'.requested_reviewers | arr | map(select(.login | is_copilot)) | length > 0')" || pull_ok=0
          fi
          if [ "$check_seen" = true ] || [ "$review_seen" = true ] || [ "$requested" = true ]; then
            echo "$awaiting"
            exit 1
          fi
          # 4. Only four clean answers may declare Copilot uninvolved: a failed
          #    probe may have hidden the rule or a signal, so anything less
          #    fails closed and a re-run resolves it.
          if [ "$rules_ok" = 1 ] && [ "$checks_ok" = 1 ] && [ "$reviews_ok" = 1 ] && [ "$pull_ok" = 1 ]; then
            echo "copilot is not a reviewer on this PR"
            exit 0
          fi
          echo "::error::cannot rule Copilot's involvement in PR #$PR_NUMBER out: at least one API probe failed. Not a verdict on the commit - re-run this job."
          exit 1
{# compose:ci-gate-jobs #}
  all-green:
    name: all-green
    if: always()
    needs:
      - checks
{%- if private %}
      - base-checks
{%- endif %}
{%- if not private %}
      - typography
      - commit-names
      - actionlint
      - gitleaks
      - yamllint
      - dependency-review
{%- endif %}
      - copilot-review
{# compose:ci-gate-needs -#}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: All jobs green
        env:
          NEEDS: {% raw %}${{ toJson(needs) }}{% endraw %}
        run: |
          set -o pipefail
          jq -r 'to_entries[] | "\(.value.result)\t\(.key)"' <<< "$NEEDS"
          failed="$(jq -r 'to_entries[] | select(.value.result != "success") | .key' <<< "$NEEDS" | tr '\n' ' ')"
          if [ -n "$failed" ]; then
            echo "::error::all-green failed: ${failed% } did not succeed. Open the failing job's log in this run, fix the failure, and push again."
            exit 1
          fi
{# compose:ci-release-please #}