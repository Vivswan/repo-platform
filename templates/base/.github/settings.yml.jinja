---
# This repository's OWN settings, applied by {{ github_username }}/repo-platform
# (its central settings run: after every green main merge there and
# nightly). Rendered once, repo-owned: template sync never rewrites it.
# Fleet defaults merge UNDER this file - keys here win, null opts out,
# labels replace by name, rulesets MERGE by name; both must stay lists.
# The fleet invariants (squash-only merging, the protection rulesets)
# sit ABOVE and cannot be overridden. Undeclared labels are
# deleted by the apply; undeclared rulesets are left alone.

repository:
  description: {{ description | tojson }}
  # Declared even when empty: the apply manages only declared keys, so
  # this keeps it healing out-of-band edits.
  homepage: {{ homepage | tojson }}
  topics: {{ topics | tojson }}
  private: {{ private | tojson }}

# This repository's own labels (the fleet layers already carry the
# dependabot, release, and tracking labels its modules need):
# labels:
#   - name: my-label
#     color: "0e8a16"
#     description: What it marks

# This repository's own rulesets, or additions to a fleet one (an entry
# named like a fleet ruleset merges into it and adds its rules):
# rulesets:
#   - name: my-ruleset
#     target: branch
#     enforcement: active
