# Repo-owned: seeded once by repo-platform's template, never overwritten
# by sync. [extend] pulls in gitleaks' default ruleset - without it this
# file would REPLACE the defaults. minVersion is honored only by binaries
# new enough to know it, so the CI job pins GITLEAKS_VERSION past it.
minVersion = "8.30.1"

[extend]
useDefault = true
{%- set locks = [] %}
{# compose:gitleaks-locks #}
{%- if locks %}

# Generated lockfiles: integrity hashes occasionally trip the generic
# entropy rules, and secrets do not belong in generated files.
[[allowlists]]
description = "generated lockfiles"
paths = ['''(^|/)({{ locks | join('|') }})$''']
{%- endif %}

# Add further false-positive allowlists here; for a one-off finding,
# prefer an inline "gitleaks:allow" comment on the flagged line -
# finding-level, so it never excuses future secrets in the same file.
