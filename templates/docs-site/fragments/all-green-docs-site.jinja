
  # The docs deploy, in the SAME run as the gate (github.sha IS the judged
  # commit): a red main never reaches the site. Ordered behind the
  # repo-owned post-green hook and the release leg so the site picks up
  # what they landed (a tag minted this run), and gated on the all-green
  # result alone: !cancelled() keeps a red or skipped hook or release from
  # holding the site back. docs-site.yml keeps the PR check, the nightly
  # rebuild and the dispatch.
  docs-site:
    needs: [all-green, post-green{% if 'release-please' in modules %}, release{% endif %}]
    if: >-
      !cancelled() &&
      needs.all-green.result == 'success' &&
      github.event_name == 'push' &&
      github.ref == 'refs/heads/main'
    # The lane every deploy holds: the called docs-site.yml keys a called
    # run per run and holds this group only on its nightly and dispatch runs.
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      contents: read
      pages: write
      id-token: write
      issues: write
    uses: ./.github/workflows/docs-site.yml
    with:
      sha: {% raw %}${{ github.sha }}{% endraw %}