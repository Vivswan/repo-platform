# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# The docs site: this repository's docs/ markdown rendered under the
# central fleet theme (repo-platform's actions/pages-site) - layout,
# versioning, locales, and conventions in repo-platform's docs/docs-site.md.
# The check job builds docs/ strictly on every PR touching it (dead
# internal links fail there instead of at deploy time); paths-filtered by
# design, so it is never in the all-green roster and never a required
# check.{% if 'pages' not in modules %} One-time setup without the settings-sync module: repo
# Settings -> Pages -> Source: GitHub Actions (with it, the module's
# settings layer enables Pages automatically).{% endif %}{% if 'pages' in modules %} The deploy itself lives in
# pages.yml: with the pages module selected, the website rides at / and
# the docs mount at /{{ docs_site_path }}/ in ONE Pages deployment.{% endif %}
name: Docs Site

on:
  pull_request:
    paths:
      - docs/**
{% if 'pages' not in modules %}  push:
    branches: [main]
    paths:
      - docs/**
  schedule:
    # Nightly rebuild: central theme updates and version tags created
    # without a docs push propagate, and the external-link check runs
    # (docs/docs-site.md).
    - cron: "41 4 * * *"
  workflow_dispatch:
{% endif %}
permissions:
  contents: read

jobs:
  check:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      - uses: {{ github_username }}/repo-platform/actions/pages-site@build
        with:
          check: "true"
          site-title: {{ project_name | tojson }}
{% if 'pages' not in modules %}
  deploy:
    if: github.event_name != 'pull_request'
    concurrency:
      group: pages
      cancel-in-progress: false
    uses: {{ github_username }}/repo-platform/.github/workflows/reusable-pages.yml@build
    with:
      mounts: '[{"path": "/", "source": "vitepress", "versioned": true}]'
      site_title: {{ project_name | tojson }}
      link_rot_label: {{ docs_site_label | tojson }}
      custom_domain: {% raw %}${{ vars.CUSTOM_DOMAIN }}{% endraw %}
    permissions:
      contents: read
      pages: write
      id-token: write
      issues: write
{% endif %}