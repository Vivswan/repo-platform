# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# The docs site: this repository's docs/ markdown rendered under the
# central fleet theme (repo-platform's actions/pages-site) - layout,
# versioning, locales, and conventions in repo-platform's docs/docs-site.md.
# The check job builds docs/ strictly on every PR touching it (dead
# internal links fail there instead of at deploy time); paths-filtered by
# design, so it is never in the all-green roster and never a required
# check. The push deploy is ci.yml's `docs-site` job (or its `pages` job
# where that module carries the docs as a mount), downstream of the
# all-green gate with the judged commit; this workflow is the nightly
# rebuild and the manual dispatch, both building the default branch head.
# Pages is enabled by this module's settings layer on the next fleet
# settings apply; a deploy before that needs repo Settings -> Pages ->
# Source: GitHub Actions.
name: Docs Site

on:
  pull_request:
    paths:
      - docs/**
  schedule:
    # Nightly rebuild: central theme updates and version tags created
    # without a push propagate, and the external-link check runs
    # (docs/docs-site.md).
    - cron: "41 4 * * *"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  check:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      - uses: {{ github_username }}/repo-platform/actions/pages-site@build
        with:
          check: "true"

  deploy:
    if: github.event_name != 'pull_request'
    concurrency:
      group: pages
      cancel-in-progress: false
    uses: {{ github_username }}/repo-platform/.github/workflows/reusable-pages.yml@build
    with:
      custom_domain: {% raw %}${{ vars.CUSTOM_DOMAIN }}{% endraw %}
    permissions:
      contents: read
      pages: write
      id-token: write
      issues: write
