# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# Draft-first because published releases freeze (a late upload gets 422).
# Without REPO_PLATFORM_TOKEN the release PR is created by GITHUB_TOKEN
# and needs a close/reopen to run its checks. If the pipeline dies after
# the draft exists, a rerun cannot recreate it (the tag is forced) -
# re-run the failed jobs, or finish by hand:
#   gh release upload <tag> <assets> --clobber
#   gh release edit <tag> --draft=false

name: Release

on:
  workflow_call:

jobs:
  release-please:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # Caps a caller that grants more; the read keys feed release-health.
    permissions:
      contents: write
      pull-requests: write
      issues: read
      vulnerability-alerts: read
    outputs:
      release_created: {% raw %}${{ steps.release.outputs.release_created }}{% endraw %}
      tag_name: {% raw %}${{ steps.release.outputs.tag_name }}{% endraw %}
      # pr is unset when no PR was proposed; the && short-circuit keeps
      # fromJSON off the empty string.
      prs_created: {% raw %}${{ steps.release.outputs.prs_created }}{% endraw %}
      pr_number: {% raw %}${{ steps.release.outputs.pr && fromJSON(steps.release.outputs.pr).number }}{% endraw %}
      pr_head_branch: {% raw %}${{ steps.release.outputs.pr && fromJSON(steps.release.outputs.pr).headBranchName }}{% endraw %}
    steps:
      # A green run releases only the head it tested; gh api (not
      # anonymous ls-remote) so private repositories work.
      - name: Check this run tested the current head
        id: head
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          head="$(gh api "repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq .object.sha)"
          if [ "$head" = "$GITHUB_SHA" ]; then
            echo "current=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::main moved to ${head:0:7} since this run started; the newer run releases"
            echo "current=false" >> "$GITHUB_OUTPUT"
          fi
      # The release PR's CI health check can be stale by merge time, so
      # the same gate re-runs here; release mode self-scopes to
      # release-cut pushes.
      - uses: {{ github_username }}/repo-platform/actions/release-health@build
        if: steps.head.outputs.current == 'true'
        with:
          mode: release
{#- BEGIN GENERATED: tracking-labels (scripts/generate.ts - edit module.yml manifests, not this block) #}
{%- if 'fuzzer' in modules or 'nightly' in modules %}
          tracking-labels: {{ (([fuzzer_label] if 'fuzzer' in modules else []) + ([nightly_label] if 'nightly' in modules else [])) | join(',') | tojson }}
{%- endif %}
{#- END GENERATED: tracking-labels #}
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
      - uses: googleapis/release-please-action@v5
        id: release
        if: steps.head.outputs.current == 'true'
        with:
          token: {% raw %}${{ secrets.REPO_PLATFORM_TOKEN || github.token }}{% endraw %}
      # release-please's propose phase silently ABORTS - green - while a
      # merged PR still wears "autorelease: pending". Checked AFTER the
      # action so its recovery phase runs first; 30 minutes covers labels
      # legitimately pending right after a merge.
      - name: Fail when a stale pending release PR parks release-please
        if: steps.head.outputs.current == 'true'
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
        run: |
          cutoff="$(date -u -d '30 minutes ago' +%Y-%m-%dT%H:%M:%SZ)"
          stale="$(gh pr list --state merged --label 'autorelease: pending' \
            --limit 100 --json number,mergedAt \
            --jq "[.[] | select(.mergedAt < \"$cutoff\") | \"#\\(.number)\"] | join(\", \")")"
          if [ -n "$stale" ]; then
            echo "::error::merged release PR(s) $stale have worn 'autorelease: pending' for over 30 minutes, so release-please refuses to propose any new release ('untagged, merged release PRs outstanding'). Finish or abandon that release, then move the label to 'autorelease: tagged'."
            exit 1
          fi

  # No permissions block on purpose: the repo-owned hook gets the calling
  # job's full publishing ceiling; its jobs narrow it themselves.
  update-release:
    needs: [release-please]
    if: needs.release-please.outputs.release_created == 'true'
    uses: ./.github/workflows/update-release.yml
    with:
      tag: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
    secrets: inherit

  # Gates are runtime on purpose: assets are only knowable at runtime,
  # and attestation needs a public repository, so non-public releases
  # publish unattested.
  publish-release:
    needs: [release-please, update-release]
    # Implied by the needs chain; the job that flips a release live keeps
    # its own explicit gate on purpose.
    if: needs.release-please.outputs.release_created == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      id-token: write
      attestations: write
    env:
      GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
      TAG: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
    steps:
      # A stale attestation.jsonl from a prior attempt is deleted from the
      # RELEASE, so no later skip path can publish it.
      - name: Inspect the draft release's assets
        id: assets
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          names="$(gh release view "$TAG" --json assets --jq '.assets[].name')"
          if grep -qxF attestation.jsonl <<< "$names"; then
            gh release delete-asset "$TAG" attestation.jsonl --yes
          fi
          if [ -n "$(grep -vxF attestation.jsonl <<< "$names" || true)" ]; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::the release has no assets; nothing to attest"
            echo "present=false" >> "$GITHUB_OUTPUT"
          fi
      - name: Download the assets for attestation
        id: download
        if: >-
          steps.assets.outputs.present == 'true'
          && github.event.repository.visibility == 'public'
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          mkdir assets
          gh release download "$TAG" --dir assets
      - uses: actions/attest-build-provenance@v4
        id: attest
        if: steps.download.outcome == 'success'
        with:
          subject-path: assets/*
      # bundle-path is empty when download/attest skipped: a no-asset or
      # non-public release publishes without an attestation.jsonl.
      - name: Attach the attestation bundle to the draft
        if: steps.attest.outputs.bundle-path != ''
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          BUNDLE: {% raw %}${{ steps.attest.outputs.bundle-path }}{% endraw %}
        run: |
          cp "$BUNDLE" attestation.jsonl
          gh release upload "$TAG" attestation.jsonl --clobber
      - name: Publish the GitHub release
        env:
          GH_TOKEN: {% raw %}${{ secrets.REPO_PLATFORM_TOKEN || github.token }}{% endraw %}
        run: gh release edit "$TAG" --draft=false

  # prs_created is independent of release_created, so this never delays
  # publish-release. Same ceiling passthrough as update-release.
  update-release-pr:
    needs: [release-please]
    if: needs.release-please.outputs.prs_created == 'true'
    uses: ./.github/workflows/update-release-pr.yml
    with:
      pr_number: {% raw %}${{ needs.release-please.outputs.pr_number }}{% endraw %}
      head_branch: {% raw %}${{ needs.release-please.outputs.pr_head_branch }}{% endraw %}
    secrets: inherit
