# Repo-owned release pipeline, called by the managed ci.yml on top of the
# all-green gate. Generated once by {{ github_username }}/repo-platform and
# never overwritten by template sync.
#
# GitHub releases are immutable once published: the tag and assets freeze,
# and a post-publication `gh release upload` gets HTTP 422. release-please
# therefore cuts every release as a DRAFT with its tag already forced
# (`draft` + `force-tag-creation` in release-please-config.json). Jobs that
# mutate the release (uploading assets, editing notes) run after
# release-please and before the job that publishes the draft, which must
# stay last: list every mutating job in the publishing job's `needs`. If
# the pipeline dies after the draft exists, a rerun cannot recreate it
# (release-please sees the forced tag); finish by hand:
#   gh release upload <tag> <assets> --clobber
#   gh release edit <tag> --draft=false
# Everything runs in the same workflow run, so it works with the default
# GITHUB_TOKEN too, which cannot trigger `on: release` workflows.

name: Release

on:
  workflow_call:

jobs:
  release-please:
    uses: ./.github/workflows/release-please.yml
    secrets: inherit
{%- if release_auto_publish %}

  publish-release:
    needs: [release-please]
    if: needs.release-please.outputs.release_created == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Publish the GitHub release
        env:
          GH_TOKEN: {% raw %}${{ secrets.REPO_PLATFORM_TOKEN || github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          TAG: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
        run: gh release edit "$TAG" --draft=false
{%- else %}

# Generated with release_auto_publish=false: this repository publishes the
# draft itself. Run `gh release edit <tag> --draft=false` as the final step
# of your own pipeline once the release is ready to freeze.
{%- endif %}

