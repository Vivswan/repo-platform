
  # This wrapper runs the default branch's copy, so the leg goes live on
  # the first main push after the sync PR delivering it merges.
  release:
    needs: [verdict]
    # result is spelled out so the release never depends on GitHub's
    # implied-success() rule; conclusion is empty on a pending verdict and
    # unset on a refused one, so neither can release.
    if: >-
      needs.verdict.result == 'success' &&
      needs.verdict.outputs.conclusion == 'success' &&
      github.event_name == 'workflow_run' &&
      github.event.workflow_run.event == 'push' &&
      github.event.workflow_run.head_branch == 'main'
    # Deliberately a lane no group inside the called release.yml takes:
    # this job HOLDS it while its called jobs run, so one name would
    # deadlock.
    concurrency:
      group: post-green-release
      cancel-in-progress: false
    permissions:
      contents: write
      pull-requests: write
      packages: write
      id-token: write
      attestations: write
      issues: read
      vulnerability-alerts: read
    uses: ./.github/workflows/release.yml
    with:
      # Never github.sha: on workflow_run events that is main's CURRENT
      # tip, which can already be a newer - even red - commit.
      sha: {% raw %}${{ github.event.workflow_run.head_sha }}{% endraw %}
    secrets: inherit
