
  # Runs in the SAME workflow run as the judged commit, downstream of the
  # gate, so github.sha IS the judged commit; release.yml's head gate
  # still skips when main has moved on (the newer run releases).
  release:
    needs: [all-green]
    # result is spelled out so the release never depends on GitHub's
    # implied-success() rule; the event clauses keep PR, dispatch, and
    # schedule runs from ever releasing.
    if: >-
      needs.all-green.result == 'success' &&
      github.event_name == 'push' &&
      github.ref == 'refs/heads/main'
    # Deliberately a lane no group inside the called release.yml takes:
    # this job HOLDS it while its called jobs run, so one name would
    # deadlock.
    concurrency:
      group: post-green-release
      cancel-in-progress: false
    permissions:
      contents: write
      pull-requests: write
      packages: write
      id-token: write
      attestations: write
      issues: read
      vulnerability-alerts: read
    uses: ./.github/workflows/release.yml
    with:
      sha: {% raw %}${{ github.sha }}{% endraw %}
    secrets: inherit
