# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# Without REPO_PLATFORM_TOKEN the run warns and skips. No heal cron here:
# {{ github_username }}/repo-platform's central settings-repos run applies
# this repository's settings regardless of this workflow.

name: Settings Sync

on:
  push:
    branches: [main]
    paths: [.github/settings.yml]
  workflow_dispatch:
    inputs:
      check_only:
        description: Report drift without writing
        required: false
        type: boolean
        default: false

permissions:
  contents: read

jobs:
  apply:
    uses: {{ github_username }}/repo-platform/.github/workflows/reusable-apply-settings.yml@build
    with:
      check_only: {% raw %}${{ inputs.check_only || false }}{% endraw %}
    secrets:
      REPO_PLATFORM_TOKEN: {% raw %}${{ secrets.REPO_PLATFORM_TOKEN }}{% endraw %}
