# Nightly CI starter: generated once by {{ github_username }}/repo-platform,
# never overwritten by template sync. Replace the placeholder step; the
# report job files one label-deduplicated tracking issue on a red night
# and closes it on a green one (docs/nightly.md).
name: Nightly

on:
  schedule:
    # Pick your own minute so the fleet's nightlies do not all land at
    # once.
    - cron: "59 6 * * *"
  workflow_dispatch:

concurrency:
  group: nightly
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  checks:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v7

      # Add sibling jobs freely: list each in the report job's `needs` and
      # fold its result into the red/green conditions there.

      - name: Nightly checks
        run: |
          # Replace with the repository's nightly checks. A green no-op
          # until then: an uncustomized starter must not file issues.
          echo "::warning::nightly starter not customized yet - replace the placeholder step (see repo-platform's docs/nightly.md)"

  # A CANCELLED checks job counts as red: hitting the timeout cancels
  # rather than fails, and a hang is exactly what a nightly exists to
  # catch.
  report:
    needs: [checks]
    if: always()
    runs-on: ubuntu-latest
    # A hung reporter is the residual silence window; keep this tight.
    timeout-minutes: 5
    # issues: write lets the fuzz-issue action file/close the tracking issue{% if 'auto-assign' in modules %};
    # actions: write lets the red path dispatch auto-assign at it{% endif %}.
    permissions:
      issues: write
{% if 'auto-assign' in modules %}      actions: write
{% endif %}    steps:
      - name: File or update the nightly issue
        id: file-issue
        if: {% raw %}needs.checks.result == 'failure' || needs.checks.result == 'cancelled'{% endraw %}
        uses: {{ github_username }}/repo-platform/actions/fuzz-issue@build
        with:
          mode: report
          label: {{ nightly_label | tojson }}
          title: Nightly CI failures
          # No artifacts directory: this stream files the generic report,
          # not the fuzzer's failure-report contract. The label tuple is
          # used only at creation and matches the settings-sync one.
          label-color: "D93F0B"
          label-description: Automated nightly CI failure

{% if 'auto-assign' in modules %}      # A GITHUB_TOKEN-created issue fires no triggers, so dispatch auto-assign.
      - name: Trigger auto-assign for the filed issue
        if: {% raw %}steps.file-issue.outputs.issue-number != ''{% endraw %}
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          # This job has no checkout, so gh has no working tree to infer the
          # repository from; name it explicitly.
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          ISSUE_NUMBER: {% raw %}${{ steps.file-issue.outputs.issue-number }}{% endraw %}
        run: gh workflow run auto-assign.yml -f "issue=$ISSUE_NUMBER" || echo "::warning::could not dispatch auto-assign.yml"

{% endif %}      - name: Close the nightly issue on a green night
        if: {% raw %}needs.checks.result == 'success'{% endraw %}
        uses: {{ github_username }}/repo-platform/actions/fuzz-issue@build
        with:
          mode: resolve
          label: {{ nightly_label | tojson }}
          # The generic close wording; without it the action keeps the fuzz
          # stream's regression-seed hedging.
          stream: generic
