# This file is managed by {{ github_username }}/repo-platform.
# Local edits may be replaced during template updates.
#
# The versioned Pages layout, the build contract (PAGES_BASE_PATH,
# PAGES_ORIGIN, PAGES_VERSION), and the CUSTOM_DOMAIN cutover:
# repo-platform's docs/pages.md. Pages is enabled by this module's settings
# layer on the next fleet settings apply; a deploy before that needs repo
# Settings -> Pages -> Source: GitHub Actions.
#
# Three ways in: ci.yml's `pages` job calls this workflow downstream of
# the all-green gate with the judged commit (a red main never deploys),
# the nightly rebuild and a manual dispatch build the default branch head.
name: Pages

on:
  workflow_call:
    inputs:
      sha:
        description: The green commit ci.yml's pages job judged - the commit this deploy builds.
        required: true
        type: string
  schedule:
    # Nightly rebuild: version tags created without a push land, and
    # central pipeline updates propagate (docs/pages.md).
    - cron: "23 4 * * *"
  workflow_dispatch:

permissions:
  contents: read

# The nightly and dispatch runs hold the pages lane here; a called run
# takes a per-run group, since ci.yml's pages job already holds the lane
# and a called workflow must never wait on the lane its caller holds.
concurrency:
  group: {% raw %}${{ inputs.sha != '' && format('pages-called-{0}', github.run_id) || 'pages' }}{% endraw %}
  cancel-in-progress: false

jobs:
  deploy:
    uses: {{ github_username }}/repo-platform/.github/workflows/reusable-pages.yml@build
    with:
      sha: {% raw %}${{ inputs.sha }}{% endraw %}
{% if 'docs-site' in modules %}      mounts: '[{"path": "/", "source": "command", "versioned": false}, {"path": "/{{ docs_site_path }}/", "source": "vitepress", "versioned": true}]'
      site_title: {{ project_name | tojson }}
      link_rot_label: {{ docs_site_label | tojson }}
{% else %}      mounts: '[{"path": "/", "source": "command", "versioned": true}]'
{% endif %}      setup: {{ pages_setup }}
      install_command: {{ pages_install_command | tojson }}
      build_command: {{ pages_build_command | tojson }}
      dist_dir: {{ pages_dist_dir | tojson }}
      custom_domain: {% raw %}${{ vars.CUSTOM_DOMAIN }}{% endraw %}
    permissions:
      contents: read
      pages: write
      id-token: write
      issues: write
