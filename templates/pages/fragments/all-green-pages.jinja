
  # The Pages deploy, in the SAME run as the gate (github.sha IS the
  # judged commit): a red main never reaches the site. With release-please
  # selected it is ORDERED behind the release leg, so a release commit's
  # own deploy serves its new tag; !cancelled() keeps the edge an order,
  # not a gate: a failed or skipped release (a red hook skips it) still
  # deploys (docs/pages.md). pages.yml keeps the nightly and the dispatch.
  pages:
    needs: [all-green{% if 'release-please' in modules %}, release{% endif %}]
    if: >-
{%- if 'release-please' in modules %}
      !cancelled() &&
{%- endif %}
      needs.all-green.result == 'success' &&
      github.event_name == 'push' &&
      github.ref == 'refs/heads/main'
    # The lane every deploy holds: the called pages.yml keys a called run
    # per run and holds this group only on its nightly and dispatch runs.
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      contents: read
      pages: write
      id-token: write
      issues: write
    uses: ./.github/workflows/pages.yml
    with:
      sha: {% raw %}${{ github.sha }}{% endraw %}
