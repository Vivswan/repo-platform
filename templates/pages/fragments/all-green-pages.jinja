
  # The Pages deploy, in the SAME run as the gate (github.sha IS the
  # judged commit): a red main never reaches the site. Independent of the
  # repo-owned post-green hook and the release leg, so a red hook never
  # holds the site back; a tag minted this run lands on the nightly
  # rebuild (docs/pages.md). pages.yml keeps the nightly and the dispatch.
  pages:
    needs: [all-green]
    if: >-
      needs.all-green.result == 'success' &&
      github.event_name == 'push' &&
      github.ref == 'refs/heads/main'
    # The lane every deploy holds: the called pages.yml keys a called run
    # per run and holds this group only on its nightly and dispatch runs.
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      contents: read
      pages: write
      id-token: write
      issues: write
    uses: ./.github/workflows/pages.yml
    with:
      sha: {% raw %}${{ github.sha }}{% endraw %}