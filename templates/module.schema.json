{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Generated by scripts/generate.ts from the zod schema in scripts/module_manifests.ts - do not edit. Only structural and pattern constraints translate to JSON Schema; the zod refinements (single-line, quote/metacharacter safety) do not, so the loader remains the enforcement layer.",
  "title": "repo-platform module manifest (templates/<module>/module.yml)",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "const": "managed"
              },
              "headerless": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "path",
              "class"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "const": "starter"
              }
            },
            "required": [
              "path",
              "class"
            ],
            "additionalProperties": false
          },
          {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "class": {
                    "type": "string",
                    "const": "split"
                  },
                  "grammar": {
                    "type": "string",
                    "const": "tail-marker"
                  },
                  "marker": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "class",
                  "grammar",
                  "marker"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "class": {
                    "type": "string",
                    "const": "split"
                  },
                  "grammar": {
                    "type": "string",
                    "const": "bounded-region"
                  },
                  "managed_begin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "managed_end": {
                    "type": "string",
                    "minLength": 1
                  },
                  "local_begin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "local_end": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "class",
                  "grammar",
                  "managed_begin",
                  "managed_end",
                  "local_begin",
                  "local_end"
                ],
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "codeql_language": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "pin": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^\\.[a-z][a-z0-9.-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          },
          "required": [
            "file",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "codeql_language"
      ],
      "additionalProperties": false
    },
    "dependabot": {
      "type": "object",
      "properties": {
        "ecosystem": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z0-9:_-]+$"
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9a-f]{6}$"
        }
      },
      "required": [
        "ecosystem",
        "label",
        "color"
      ],
      "additionalProperties": false
    },
    "tracking_label": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "default": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._][A-Za-z0-9._: -]{0,49}$"
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "answer",
        "default",
        "color",
        "description"
      ],
      "additionalProperties": false
    },
    "settings_layers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "settings.yml",
          "settings-public.yml",
          "settings-private.yml"
        ]
      }
    },
    "gitignore_sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lockfiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pages": {
      "type": "object",
      "properties": {
        "install": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "install",
        "build"
      ],
      "additionalProperties": false
    },
    "gate_jobs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "gate_dirs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "description"
  ],
  "additionalProperties": false
}
