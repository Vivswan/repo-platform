# Normalize all detected text files to LF in the repository.
* text=auto eol=lf

# Never apply text/EOL normalization to repo symlinks, so a Windows checkout
# (core.symlinks=false) can't turn them into modified regular files.
CLAUDE.md -text
.github/copilot-instructions.md -text
.github/agents.md -text
templates/agents/CLAUDE.md -text
templates/agents/.github/copilot-instructions.md -text
templates/agents/.github/agents.md -text

# Render the extensionless LICENSE as Markdown on GitHub.
LICENSE linguist-language=Markdown

# Keep binary assets byte-for-byte unchanged.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary

# Repository-specific attributes (binary globs, linguist overrides) go
# below this line. They survive template updates via three-way merge.
# repo-platform:local-section
