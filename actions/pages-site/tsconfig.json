{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"]
  },
  "include": ["*.ts", ".vitepress/**/*.ts", ".vitepress/**/*.mts"]
}
