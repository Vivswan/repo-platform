{
  "problemMatcher": [
    {
      "owner": "typos",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+): error: (`.+` (?:should be|is disallowed).*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
