# This repo's copy of the template's shared yamllint configuration.
extends: default

ignore:
  - .venv
  - node_modules
  - template # .jinja files are not valid YAML pre-render (composed tree)
  - templates # .jinja sources; module.yml is validated by the composer
  # Machine-generated by copier inside the golden renders (pyyaml emits
  # unindented sequences, which the default indentation rule rejects) -
  # the same entry the template ships; the rest of the golden YAML stays
  # linted like any rendered repo would lint it.
  - .copier-answers.yml

rules:
  document-start: disable # no --- preamble required
  line-length: disable # workflow `if:` expressions run long
  truthy:
    check-keys: false # GitHub workflows' `on:` key is fine
  comments:
    min-spaces-from-content: 1
