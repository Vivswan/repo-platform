# This repository's own yamllint configuration; the fleet's is files/base/.yamllint.
extends: default

ignore:
  - .venv
  - node_modules
  - files # the sync writer's sources: `{{placeholder}}` tokens are not YAML before substitution

rules:
  document-start: disable # no --- preamble required
  line-length: disable # workflow `if:` expressions run long
  truthy:
    check-keys: false # GitHub workflows' `on:` key is fine
  comments:
    min-spaces-from-content: 1
